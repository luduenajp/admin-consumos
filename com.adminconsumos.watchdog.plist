<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.adminconsumos.watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/pablo/github/admin-consumos/watchdog.sh</string>
  </array>

  <!-- Ejecutar cada 15 minutos (900 segundos) -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!-- También correr al cargarse (por si el startup falló) -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/pablo/Library/Logs/admin-consumos/watchdog.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/pablo/Library/Logs/admin-consumos/watchdog.log</string>
</dict>
</plist>
